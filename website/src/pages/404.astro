---
import Site from "../layouts/Site.astro";
const title = "Page not found — Git Mapper";
const description = "That page does not exist. Head back to the Git Mapper home page.";
---

<Site title={title} description={description}>
  <main class="mx-auto max-w-3xl px-6 pb-24 pt-32 text-center">
    <p class="font-mono text-sm text-ink-dim">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight">This ref is not in the log</h1>
    <p class="mt-4 text-ink-soft">The page you were looking for does not exist.</p>
    <a href="/" class="mt-8 inline-block rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-white soft-shadow hover:brightness-110">Back to home</a>
  </main>
</Site>
