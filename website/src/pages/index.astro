---
import { Image } from "astro:assets";
import Site from "../layouts/Site.astro";
import ThemeSlider from "../react/ThemeSlider";

// Assets: the real brand file + every icon lives as its own file under src/assets/.
import shotGraph from "../assets/screens/graph.png";
import shotStage from "../assets/screens/stage.png";
import shotHunk from "../assets/screens/hunk.png";
import shotConflict from "../assets/screens/conflict.png";
import shotSplit from "../assets/screens/split.png";
import logoRaw from "../assets/logo.svg?raw";
import iconDownload from "../assets/icons/download.svg?raw";
import iconGithub from "../assets/icons/github-mark.svg?raw";
import iconWindows from "../assets/icons/windows.svg?raw";
import iconApple from "../assets/icons/apple.svg?raw";
import iconLinux from "../assets/icons/linux.svg?raw";

const title = "Git Mapper — Git, easy as a click. A Git visualizer for Windows, macOS and Linux";
const description =
  "Git, easy as a click. Git Mapper is a fast, lightweight Git visualizer: follow the lane-coloured graph, read unified or split diffs, and stage, commit and merge with a click. Free for Windows, macOS and Linux.";

const RELEASES = "https://github.com/fajarwz/git-mapper/releases/latest";
const REPO = "https://github.com/fajarwz/git-mapper";
const DOWNLOADS = {
  windows: `${RELEASES}/download/Git.Mapper_x64-setup.exe`,
  macos: `${RELEASES}/download/Git.Mapper.dmg`,
  linux: `${RELEASES}/download/Git.Mapper_amd64.AppImage`,
};

const features = [
  {
    title: "The graph, in lane colours",
    body: "Every branch owns a hue from tip to root. Forks bend exactly at their commit, merges join back cleanly, and dense lanes stay readable hundreds of rows in.",
    points: [
      "Branch, remote and tag pills on every row; double-click to check out",
      "Search by hash, message, author or ref with Ctrl+F",
      "Reorder, resize and hide columns to suit you",
      "Each repository in its own tab, restored on launch",
    ],
    img: shotGraph,
    alt: "The commit graph: five branches in their own colours forking and merging back into main, with branch, tag and stash pills on the rows",
    layout: "side",
  },
  {
    title: "Down to the single line",
    body: "Stage or discard one hunk, or tick just the lines you mean. Commit half of a messy file as two clean commits, no command line needed.",
    points: [
      "Tick the gutter, or drag across several lines",
      "The hunk's buttons become Stage, Unstage or Discard N lines",
      "Staged and unstaged sides shown one at a time, like VS Code",
      "A hunk that moved underneath you is refused, never misapplied",
    ],
    img: shotHunk,
    alt: "An uncommitted diff with five changed lines ticked, and the hunk header now offering Stage +4 -1, Discard +4 -1 and Clear",
    layout: "side-reverse",
  },
  {
    title: "Stage, commit, undo",
    body: "The uncommitted row opens a staging rail beside the diff. Stage, unstage or discard by file, write the message and commit. Changed your mind? Undo the tip commit and its files come back staged.",
    points: [
      "Stage, unstage or discard a whole hunk in one click",
      "Fetch, pull (fast-forward only) and push from the branch counters",
      "Destructive actions sit behind a clear confirm",
      "The rail docks itself once the working tree is clean",
    ],
    img: shotStage,
    alt: "The staging rail listing a staged file and three changes beside the staged diff of src/lib/graph.ts, with an Unstage hunk button",
    layout: "text-first",
  },
  {
    title: "Merge, and settle conflicts in place",
    body: "Merge a local branch from its pill. If git stops on conflicts they land in the rail: take a side per file, or open the file and pick current, incoming or both for each block.",
    points: [
      "Conflict blocks inline, with line numbers and syntax colours",
      "Keep current, keep incoming, or keep both, block by block",
      "Finish with git's own prepared message",
      "Or abort and the repository returns to how it was",
    ],
    img: shotConflict,
    alt: "A merge conflict in src/config.ts shown inline with Keep current, Keep both and Keep incoming buttons, and a Conflicts section in the staging rail",
    layout: "text-first",
  },
  {
    title: "Diffs that read",
    body: "Unified or split like GitHub, syntax highlighted in three colour schemes, with word-level marks showing exactly what changed.",
    points: [
      "One file at a time, or every changed file stacked in one scroll",
      "Flat list or folder tree, with status badges and renames",
      "Picture diffs for images: 2-up, swipe or onion peel",
      "Hover a file and its patch is already loading",
    ],
    img: shotSplit,
    alt: "A commit selected in the graph with its split diff open: the old lines on the left, the new lines on the right",
    layout: "text-first",
  },
];

const extras = [
  { title: "Stashes", body: "Each stash gets its own row above the commit it was taken on. Apply, pop or drop from its menu." },
  { title: "Always current", body: "Focus the window and it re-checks branches and the worktree. A background fetch keeps ahead/behind honest." },
  { title: "Tabs that remember", body: "Selected commit, file and panel state per repository. Drag to reorder; idle tabs sleep to save memory." },
  { title: "Right-click menus", body: "Check out a branch or commit, copy hashes and ref names, merge, undo the tip, handle stashes." },
  { title: "Light and dark", body: "Two themes, zoom the whole window with Ctrl plus, minus and zero, window position restored on launch." },
  { title: "Updates itself", body: "Checks on launch, downloads in the background, restarts when you say so." },
];

const systems = [
  { key: "windows", name: "Windows", icon: iconWindows, href: DOWNLOADS.windows, file: "Git.Mapper_x64-setup.exe", note: "Unsigned installer. If SmartScreen appears, click More info, then Run anyway." },
  { key: "macos", name: "macOS", icon: iconApple, href: DOWNLOADS.macos, file: "Git.Mapper.dmg", note: "Apple Silicon and Intel. Signed, not notarized: on first launch, right-click the app and pick Open." },
  { key: "linux", name: "Linux", icon: iconLinux, href: DOWNLOADS.linux, file: "Git.Mapper_amd64.AppImage", note: "Runs without installing." },
];
---

<Site title={title} description={description}>
  <header class="sticky top-0 z-50 border-b border-rule backdrop-blur-xl" style="background-color: var(--color-glass-soft)">
    <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6">
      <a href="/" class="flex items-center gap-2.5" aria-label="Git Mapper home">
        <span class="inline-block h-8 w-8" set:html={logoRaw} aria-hidden="true" />
        <span class="text-[15px] font-bold tracking-tight">Git Mapper</span>
      </a>
      <nav class="flex items-center gap-1 text-sm font-semibold" aria-label="Main">
        <a href="#features" class="hidden rounded-lg px-3 py-1.5 text-ink-soft hover:bg-hover-glass hover:text-ink sm:block">Features</a>
        <a href="#install" class="hidden rounded-lg px-3 py-1.5 text-ink-soft hover:bg-hover-glass hover:text-ink sm:block">Install</a>
        <a
          href={REPO}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-2 flex items-center gap-2 rounded-lg border border-hairline px-3 py-1.5 text-ink backdrop-blur-md transition-colors hover:bg-hover-glass"
          style="background-color: var(--color-glass-strong)"
        >
          <span class="inline-block h-4 w-4" set:html={iconGithub} />
          GitHub
        </a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-6">
    <!-- Hero -->
    <section class="site-rise mx-auto max-w-3xl pb-12 pt-20 text-center md:pt-28">
      <h1 class="text-balance text-[clamp(2.6rem,5.4vw,4.25rem)] font-bold leading-[1.06] tracking-[-0.03em]">
        Git, easy as a click.
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
        Every branch, crystal clear. Read your history as a graph, then stage,
        commit and merge with a click. No account, no setup.
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href={RELEASES}
          class="flex items-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-white soft-shadow transition-[filter] hover:brightness-110"
        >
          <span class="inline-block h-4 w-4" set:html={iconDownload} />
          Download free
        </a>
        <a
          href={REPO}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg border border-hairline px-5 py-2.5 text-sm font-semibold text-ink backdrop-blur-md transition-colors hover:bg-hover-glass"
          style="background-color: var(--color-glass-strong)"
        >
          Browse source
        </a>
      </div>
      <p class="mt-5 text-sm text-ink-dim">
        Windows · macOS · Linux · free
      </p>
    </section>

    <!-- Theme comparison dragger -->
    <section class="site-rise mx-auto max-w-5xl pb-10">
      <div class="panel-shadow rounded-3xl border border-hairline p-2.5 backdrop-blur-xl md:p-3.5" style="background-color: var(--color-glass / 0.55)">
        <ThemeSlider
          client:visible
          lightSrc="/screens/main-light.png"
          darkSrc="/screens/main-dark.png"
          altLight="Git Mapper with a repository open, light theme: glass commit feed, lane-coloured graph, diff panel"
          altDark="The same repository in the dark theme: deep canvas with white halos, smoked glass panes"
        />
        <p class="mt-2.5 px-1.5 text-sm text-ink-dim">
          Same repository, both themes — drag the divider, or press arrow keys while it is focused.
        </p>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="mt-28 scroll-mt-24 md:mt-36">
      <div class="max-w-2xl">
        <h2 class="text-balance text-[clamp(1.9rem,3.4vw,2.7rem)] font-bold leading-[1.1] tracking-[-0.025em]">
          Read the history, then act on it.
        </h2>
        <p class="mt-4 text-lg text-ink-soft">
          Stage, commit, sync and merge without leaving the graph.
        </p>
      </div>

      <div class="mt-16 space-y-28 md:mt-20 md:space-y-36">
        {features.map((f) => (
          <article>
            {f.layout === "side" || f.layout === "side-reverse" ? (
              <div class="grid items-center gap-10 md:grid-cols-12 md:gap-12">
                <div class={f.layout === "side-reverse" ? "md:order-2 md:col-span-5" : "md:col-span-5"}>
                  <h3 class="text-balance text-[1.6rem] font-bold leading-tight tracking-[-0.02em]">{f.title}</h3>
                  <p class="mt-3 text-ink-soft">{f.body}</p>
                  <ul class="mt-6 divide-y divide-rule border-y border-rule text-[0.95rem] text-ink-soft">
                    {f.points.map((pt) => <li class="py-2.5">{pt}</li>)}
                  </ul>
                </div>
                <div class={f.layout === "side-reverse" ? "min-w-0 md:order-1 md:col-span-7" : "min-w-0 md:col-span-7"}>
                  <div class="panel-shadow overflow-hidden rounded-2xl border border-hairline bg-sheet-strong p-1.5 md:p-2">
                    <Image src={f.img} alt={f.alt} widths={[640, 1000, 1400]} sizes="(min-width: 1152px) 640px, (min-width: 768px) 55vw, 100vw" format="webp" quality={85} loading="lazy" class="block h-auto w-full rounded-xl border border-rule" />
                  </div>
                </div>
              </div>
            ) : (
              <div class="flex flex-col gap-10">
                <div class="grid gap-6 md:grid-cols-12 md:gap-12">
                  <div class="md:col-span-5">
                    <h3 class="text-balance text-[1.6rem] font-bold leading-tight tracking-[-0.02em]">{f.title}</h3>
                    <p class="mt-3 text-ink-soft">{f.body}</p>
                  </div>
                  <ul class="divide-y divide-rule border-y border-rule text-[0.95rem] text-ink-soft md:col-span-6 md:col-start-7 md:self-start">
                    {f.points.map((pt) => <li class="py-2.5">{pt}</li>)}
                  </ul>
                </div>
                <div class="panel-shadow overflow-hidden rounded-2xl border border-hairline bg-sheet-strong p-1.5 md:p-2">
                  <Image src={f.img} alt={f.alt} widths={[800, 1200, 1800, 2200]} sizes="(min-width: 1152px) 1100px, 100vw" format="webp" quality={85} loading="lazy" class="block h-auto w-full rounded-xl border border-rule" />
                </div>
              </div>
            )}
          </article>
        ))}
      </div>

      <div class="mt-28 md:mt-36">
        <h3 class="text-[1.6rem] font-bold leading-tight tracking-[-0.02em]">Also in the box</h3>
        <dl class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
          {extras.map((e) => (
            <div class="border-t border-rule pt-4">
              <dt class="font-bold tracking-tight">{e.title}</dt>
              <dd class="mt-1.5 text-[0.95rem] text-ink-soft">{e.body}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="mt-16 grid gap-4 border-t border-rule pt-8 md:grid-cols-12 md:gap-12">
        <h3 class="text-[1.6rem] font-bold leading-tight tracking-[-0.02em] md:col-span-5">You stay in control</h3>
        <p class="text-ink-soft md:col-span-6 md:col-start-7">
          Git Mapper runs your own <code class="font-mono text-[0.9em]">git</code> and
          only does what you click. Pulls are fast-forward only, and anything that
          throws work away, such as discard, drop or detach, asks first.
          No account, no cloud.
        </p>
      </div>

      <div class="mt-16 grid gap-4 border-t border-rule pt-8 md:grid-cols-12 md:gap-12">
        <h3 class="text-[1.6rem] font-bold leading-tight tracking-[-0.02em] md:col-span-5">Why I made this</h3>
        <div class="space-y-3 text-ink-soft md:col-span-6 md:col-start-7">
          <p>
            I built Git Mapper so Git stops feeling heavy. History is something
            you should be able to see, and the everyday things should be a click,
            not a command you have to look up.
          </p>
          <p class="font-semibold text-ink">Fajar</p>
        </div>
      </div>
    </section>

    <!-- Install -->
    <section id="install" class="mt-28 scroll-mt-24 pb-28 md:mt-36">
      <div class="max-w-2xl">
        <h2 class="text-balance text-[clamp(1.9rem,3.4vw,2.7rem)] font-bold leading-[1.1] tracking-[-0.025em]">
          Try it on your own repos
        </h2>
        <p class="mt-4 text-ink-soft">
          The installer for your system lives on GitHub Releases. The app checks
          for updates on launch and stays current on its own.
        </p>
      </div>

      <div id="downloads" class="mt-10">
        {systems.map((o) => (
          <div data-os-card={o.key} class="glass-panel panel-shadow hidden rounded-2xl p-6 md:p-8">
            <div class="flex items-center gap-5 max-md:flex-col max-md:items-stretch md:gap-8">
              <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-hairline bg-sheet-strong text-ink max-md:hidden">
                <span class="inline-block h-6 w-6" set:html={o.icon} />
              </span>
              <div class="min-w-0 flex-1">
                <p class="flex flex-wrap items-center gap-2.5 text-[1.4rem] font-bold tracking-tight">
                  Download for {o.name}
                  <span class="rounded-full bg-primary/12 px-2.5 py-0.5 text-xs font-bold text-primary-ink">Your system</span>
                </p>
                <p class="mt-1 font-mono text-xs text-ink-dim">{o.file}</p>
                <p class="mt-2 max-w-xl text-sm text-ink-soft">{o.note}</p>
              </div>
              <a href={o.href} class="flex shrink-0 items-center justify-center gap-2 rounded-xl bg-primary px-7 py-3.5 text-sm font-semibold text-white soft-shadow transition-[filter] hover:brightness-110">
                <span class="inline-block h-4 w-4" set:html={iconDownload} />
                Download
              </a>
            </div>
          </div>
        ))}

        <p data-desktop-note class="hidden rounded-2xl border border-hairline bg-sheet-strong px-5 py-4 text-sm text-ink-soft">
          Git Mapper is a desktop app. Open this page on your computer, or grab an installer below for later.
        </p>

        <ul id="download-list" class="mt-4 divide-y divide-rule overflow-hidden rounded-2xl border border-hairline bg-sheet-strong">
          {systems.map((o) => (
            <li data-os-row={o.key}>
              <div class="flex items-center gap-4 px-5 py-3.5 max-sm:flex-col max-sm:items-stretch max-sm:gap-3">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-hairline text-ink max-sm:hidden">
                  <span class="inline-block h-4 w-4" set:html={o.icon} />
                </span>
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-bold">{o.name}</p>
                  <p class="font-mono text-[11px] text-ink-dim">{o.file}</p>
                </div>
                <a href={o.href} class="shrink-0 rounded-lg border border-hairline bg-glass-strong px-4 py-2 text-center text-xs font-semibold text-ink transition-colors hover:bg-hover-glass">Download</a>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <p class="mt-6 text-center text-sm text-ink-soft">
        Or browse <a class="font-semibold text-primary-ink underline underline-offset-2 hover:underline" href={REPO}>the source on GitHub</a> and build it yourself with Tauri 2.
      </p>
    </section>

    <script>
      // Feature the installer for the visitor's system as a large card; the rest stay in the list.
      const ua = navigator.userAgent;
      const platform = (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform || navigator.platform || "";
      // iPadOS reports a Mac platform but has a touch screen.
      const mobile = /Android|iPhone|iPad|iPod/i.test(ua) || (/mac/i.test(platform) && navigator.maxTouchPoints > 1);
      const os = mobile ? null : /win/i.test(platform + ua) ? "windows" : /mac/i.test(platform) ? "macos" : /linux|x11/i.test(platform + ua) ? "linux" : null;
      if (mobile) document.querySelector("[data-desktop-note]")?.classList.remove("hidden");
      if (os) {
        document.querySelector(`[data-os-card="${os}"]`)?.classList.remove("hidden");
        document.querySelector(`[data-os-row="${os}"]`)?.classList.add("hidden");
      }
    </script>
  </main>

  <footer class="border-t border-rule">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-8 text-sm text-ink-dim">
      <div class="flex items-center gap-2.5">
        <span class="inline-block h-6 w-6" set:html={logoRaw} aria-hidden="true" />
        <span class="font-semibold text-ink-soft">Git Mapper</span>
        <span>— a lightweight Git history viewer</span>
      </div>
      <nav class="flex items-center gap-5" aria-label="Footer">
        <a class="hover:text-ink" href={REPO}>GitHub</a>
        <a class="hover:text-ink" href={`${REPO}/releases`}>Releases</a>
        <a class="hover:text-ink" href="https://fajarwz.com">fajarwz.com</a>
      </nav>
    </div>
  </footer>
</Site>
