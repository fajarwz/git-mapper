---
import Site from "../layouts/Site.astro";
import ThemeSlider from "../react/ThemeSlider";

// Assets: the real brand file + every icon lives as its own file under src/assets/.
import logoRaw from "../assets/logo.svg?raw";
import iconDownload from "../assets/icons/download.svg?raw";
import iconGithub from "../assets/icons/github-mark.svg?raw";
import iconWindows from "../assets/icons/windows.svg?raw";
import iconApple from "../assets/icons/apple.svg?raw";
import iconPackage from "../assets/icons/package.svg?raw";
import iconLayers from "../assets/icons/layers.svg?raw";
import iconLock from "../assets/icons/lock.svg?raw";
import iconGraphDemo from "../assets/icons/graph-demo.svg?raw";

const title = "Git Mapper — a frosted-glass Git history viewer for Windows, macOS and Linux";
const description =
  "Git Mapper is a standalone Git history viewer: a frosted-glass commit feed, a lane-coloured commit graph, split or unified syntax-highlighted diffs, and stashes as first-class rows. Free download.";

const RELEASES = "https://github.com/fajarwz/git-mapper/releases/latest";
const REPO = "https://github.com/fajarwz/git-mapper";
const DOWNLOADS = {
  windows: `${RELEASES}/download/Git.Mapper_x64-setup.exe`,
  macos: `${RELEASES}/download/Git.Mapper.dmg`,
  linux: `${RELEASES}/download/Git.Mapper_amd64.AppImage`,
};
---

<Site title={title} description={description}>
  <header class="sticky top-0 z-50 border-b border-rule backdrop-blur-xl" style="background-color: var(--color-glass-soft)">
    <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6">
      <a href="/" class="flex items-center gap-2.5" aria-label="Git Mapper home">
        <span class="inline-block h-8 w-8" set:html={logoRaw} aria-hidden="true" />
        <span class="text-[15px] font-bold tracking-tight">Git Mapper</span>
      </a>
      <nav class="flex items-center gap-1 text-sm font-semibold" aria-label="Main">
        <a href="#features" class="hidden rounded-lg px-3 py-1.5 text-ink-soft hover:bg-hover-glass hover:text-ink sm:block">Features</a>
        <a href="#install" class="hidden rounded-lg px-3 py-1.5 text-ink-soft hover:bg-hover-glass hover:text-ink sm:block">Install</a>
        <a
          href={REPO}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-2 flex items-center gap-2 rounded-lg border border-hairline px-3 py-1.5 text-ink backdrop-blur-md transition-colors hover:bg-hover-glass"
          style="background-color: var(--color-glass-strong)"
        >
          <span class="inline-block h-4 w-4" set:html={iconGithub} />
          GitHub
        </a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-6">
    <!-- Hero -->
    <section class="site-rise mx-auto max-w-3xl pb-12 pt-20 text-center md:pt-28">
      <h1 class="text-balance text-[clamp(2.6rem,5.4vw,4.25rem)] font-bold leading-[1.06] tracking-[-0.03em]">
        Git history worth having on screen.
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
        Git Mapper is a standalone Git history viewer. Open a repository and read the
        graph: what happened, which line belongs to which branch, what changed
        and in which file — without touching a terminal.
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href={RELEASES}
          class="flex items-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-white soft-shadow transition-[filter] hover:brightness-110"
        >
          <span class="inline-block h-4 w-4" set:html={iconDownload} />
          Download free
        </a>
        <a
          href={REPO}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg border border-hairline px-5 py-2.5 text-sm font-semibold text-ink backdrop-blur-md transition-colors hover:bg-hover-glass"
          style="background-color: var(--color-glass-strong)"
        >
          Browse source
        </a>
      </div>
      <p class="mt-5 font-mono text-xs tracking-tight text-ink-dim">
        Windows · macOS · Linux · free
      </p>
    </section>

    <!-- Theme comparison dragger -->
    <section class="site-rise mx-auto max-w-5xl pb-10">
      <div class="panel-shadow rounded-3xl border border-hairline p-2.5 backdrop-blur-xl md:p-3.5" style="background-color: var(--color-glass / 0.55)">
        <ThemeSlider
          client:visible
          lightSrc="/screens/main-light.png"
          darkSrc="/screens/main-dark.png"
          altLight="Git Mapper with a repository open, light theme: glass commit feed, lane-coloured graph, diff panel"
          altDark="The same repository in the dark theme: deep canvas with white halos, smoked glass panes"
        />
        <p class="mt-2.5 px-1.5 font-mono text-xs text-ink-dim">
          Same repository, both themes — drag the divider, or press arrow keys while it is focused.
        </p>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="mt-24 scroll-mt-24 md:mt-32">
      <div class="mx-auto max-w-2xl">
        <h2 class="text-balance text-[clamp(1.7rem,3vw,2.4rem)] font-bold leading-snug tracking-[-0.02em]">
          Answers "what happened here" at a glance
        </h2>
        <p class="mt-4 text-ink-soft">
          Open a repository and the graph, file list and diffs line up to explain
          it — branches, merges and stashes included.
        </p>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-6">
        <!-- The graph -->
        <article class="glass-panel panel-shadow rounded-2xl p-5 md:col-span-4 md:p-6">
          <div class="flex h-28 w-full items-stretch gap-4">
            <span class="h-28 w-40 shrink-0 md:w-56" set:html={iconGraphDemo} />
            <div class="flex-1 self-end">
              <span class="inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-[11px] font-bold" style="border-color: var(--color-lane-1); color: var(--color-lane-1)">main</span>
            </div>
          </div>
          <h3 class="mt-4 text-[1.15rem] font-bold tracking-tight">The graph, in lane colours</h3>
          <p class="mt-2 text-[0.95rem] text-ink-soft">
            Every branch owns a hue. Forks bend exactly at their commit, merges
            join back cleanly, and dense lanes stay readable hundreds of rows in.
          </p>
        </article>

        <!-- Diffs -->
        <article class="glass-panel panel-shadow rounded-2xl p-5 md:col-span-2 md:p-6">
          <div class="rounded-xl border border-rule p-3 font-mono text-[11px] leading-relaxed">
            <div class="rounded-md px-2 py-0.5 text-ink-dim" style="background-color: rgb(213 83 94 / 0.12)"><span class="text-danger-ink font-bold">−</span> const files = loadAll();</div>
            <div class="mt-1 rounded-md px-2 py-0.5 text-ink-soft" style="background-color: rgb(48 164 108 / 0.12)"><span class="text-success-ink font-bold">+</span> <span><span class="font-bold" style="color: var(--color-primary-ink)">const</span> files = <span class="font-bold" style="color: var(--color-secondary)">loadByCommit</span>(hash);</span></div>
          </div>
          <h3 class="mt-4 text-[1.15rem] font-bold tracking-tight">Diffs that read</h3>
          <p class="mt-2 text-[0.95rem] text-ink-soft">
            Unified or split side-by-side, syntax highlighted, with picture diffs
            for image changes. Every changed file: one click away.
          </p>
        </article>

        <!-- Always current -->
        <article class="glass-panel panel-shadow rounded-2xl p-5 md:col-span-2 md:p-6">
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 font-mono text-[11px] font-bold" style="background-color: rgb(110 86 207 / 0.14); color: var(--color-primary-ink)">main ↑2</span>
            <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 font-mono text-[11px] font-bold" style="background-color: rgb(208 160 75 / 0.14); color: var(--color-warning-ink)">dirty ×3</span>
            <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 font-mono text-[11px] font-bold" style="background-color: rgb(48 164 108 / 0.14); color: var(--color-success-ink)">synced</span>
          </div>
          <h3 class="mt-4 text-[1.15rem] font-bold tracking-tight">Always current</h3>
          <p class="mt-2 text-[0.95rem] text-ink-soft">
            Focus the window and it re-checks branches and the worktree — pushes,
            pulls and file edits flash in. No hammering git, no stale rows.
          </p>
        </article>

        <!-- Stashes -->
        <article class="glass-panel panel-shadow rounded-2xl p-5 md:col-span-2 md:p-6">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[11px] font-bold" style="border-color: var(--color-lane-3); color: var(--color-lane-3)">stash&#64;&#123;0&#125;</span>
            <span class="inline-block h-4 w-4 text-ink-dim" set:html={iconLayers} />
          </div>
          <h3 class="mt-4 text-[1.15rem] font-bold tracking-tight">Stashes, first-class</h3>
          <p class="mt-2 text-[0.95rem] text-ink-soft">
            Each stash gets its own row, dated where it was taken. Apply, pop or
            drop straight from the list — with confirms where they matter.
          </p>
        </article>

        <!-- Read-only -->
        <article class="glass-panel panel-shadow rounded-2xl p-5 md:col-span-2 md:p-6">
          <div class="inline-flex items-center gap-2 rounded-full border border-hairline px-2.5 py-1 text-[11px] font-bold text-ink-soft" style="background-color: var(--color-sheet-strong)">
            <span class="inline-block h-3.5 w-3.5" set:html={iconLock} />
            your work stays safe
          </div>
          <h3 class="mt-4 text-[1.15rem] font-bold tracking-tight">Gentle on your repo</h3>
          <p class="mt-2 text-[0.95rem] text-ink-soft">
            Git Mapper only reads your repository. The two things it does to
            history are deliberate: checkout is a double-click, and detaching
            HEAD asks before it happens.
          </p>
        </article>
      </div>
    </section>

    <!-- Install -->
    <section id="install" class="mt-24 scroll-mt-24 pb-24 md:mt-32">
      <div class="mx-auto max-w-2xl">
        <h2 class="text-balance text-[clamp(1.7rem,3vw,2.4rem)] font-bold leading-snug tracking-[-0.02em]">
          Try it on your own repos
        </h2>
        <p class="mt-4 text-ink-soft">
          The installer for your system lives on GitHub Releases. The app checks
          for updates on launch and stays current on its own.
        </p>
      </div>

      <div class="glass-panel panel-shadow mt-10 overflow-hidden rounded-2xl">
        <div class="flex items-center gap-4 border-b border-rule px-5 py-4 max-sm:flex-col max-sm:items-stretch max-sm:gap-3">
          <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg glass-panel text-ink">
            <span class="inline-block h-4 w-4" set:html={iconWindows} />
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-bold">Windows</p>
            <p class="truncate font-mono text-[11px] text-ink-dim">Git.Mapper_x64-setup.exe</p>
          </div>
          <a href={DOWNLOADS.windows} class="shrink-0 rounded-lg bg-primary px-4 py-2 text-xs font-semibold text-white soft-shadow transition-[filter] hover:brightness-110">Download</a>
        </div>

        <div class="flex items-center gap-4 border-b border-rule px-5 py-4 max-sm:flex-col max-sm:items-stretch max-sm:gap-3">
          <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg glass-panel text-ink">
            <span class="inline-block h-4 w-4" set:html={iconApple} />
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-bold">macOS</p>
            <p class="font-mono text-[11px] text-ink-dim">Git.Mapper.dmg — Apple Silicon &#43; Intel · first launch: right-click &#42; Open (signed, not notarized)</p>
          </div>
          <a href={DOWNLOADS.macos} class="shrink-0 rounded-lg bg-primary px-4 py-2 text-xs font-semibold text-white soft-shadow transition-[filter] hover:brightness-110">Download</a>
        </div>

        <div class="flex items-center gap-4 px-5 py-4 max-sm:flex-col max-sm:items-stretch max-sm:gap-3">
          <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg glass-panel text-ink">
            <span class="inline-block h-4 w-4" set:html={iconPackage} />
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-bold">Linux</p>
            <p class="font-mono text-[11px] text-ink-dim">Git.Mapper_amd64.AppImage — runs without installing</p>
          </div>
          <a href={DOWNLOADS.linux} class="shrink-0 rounded-lg bg-primary px-4 py-2 text-xs font-semibold text-white soft-shadow transition-[filter] hover:brightness-110">Download</a>
        </div>
      </div>

      <p class="mt-6 text-center text-sm text-ink-soft">
        Or browse <a class="font-semibold text-primary-ink underline underline-offset-2 hover:underline" href={REPO}>the source on GitHub</a> and build it yourself with Tauri 2.
      </p>
    </section>
  </main>

  <footer class="border-t border-rule">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-8 text-sm text-ink-dim">
      <div class="flex items-center gap-2.5">
        <span class="inline-block h-6 w-6" set:html={logoRaw} aria-hidden="true" />
        <span class="font-semibold text-ink-soft">Git Mapper</span>
        <span class="text-ink-dim">— a viewer for real git repositories</span>
      </div>
      <nav class="flex items-center gap-5" aria-label="Footer">
        <a class="hover:text-ink" href={REPO}>GitHub</a>
        <a class="hover:text-ink" href={`${REPO}/releases`}>Releases</a>
        <a class="hover:text-ink" href="https://fajarwz.com">fajarwz.com</a>
      </nav>
    </div>
  </footer>
</Site>
