---
import Site from "../layouts/Site.astro";
import ThemeSlider from "../react/ThemeSlider";

// Assets: the real brand file + every icon lives as its own file under src/assets/.
import logoRaw from "../assets/logo.svg?raw";
import iconDownload from "../assets/icons/download.svg?raw";
import iconGithub from "../assets/icons/github-mark.svg?raw";
import iconWindows from "../assets/icons/windows.svg?raw";
import iconApple from "../assets/icons/apple.svg?raw";
import iconPackage from "../assets/icons/package.svg?raw";
import iconLock from "../assets/icons/lock.svg?raw";

const title = "Git Mapper — a fast, lightweight Git history viewer for Windows, macOS and Linux";
const description =
  "Every branch, crystal clear. Git Mapper is a fast, lightweight Git history viewer: open a repository, follow the lane-coloured graph, read unified or split diffs, keep stashes handy. Free download.";

const RELEASES = "https://github.com/fajarwz/git-mapper/releases/latest";
const REPO = "https://github.com/fajarwz/git-mapper";
const DOWNLOADS = {
  windows: `${RELEASES}/download/Git.Mapper_x64-setup.exe`,
  macos: `${RELEASES}/download/Git.Mapper.dmg`,
  linux: `${RELEASES}/download/Git.Mapper_amd64.AppImage`,
};

const stats = [
  { value: "3", label: "platforms" },
  { value: "2", label: "themes" },
  { value: "0", label: "accounts needed" },
  { value: "Free", label: "GPL, always" },
];

const extras = [
  { title: "Stashes, first-class", body: "Each stash gets its own row above the commit it was taken on. Apply, pop or drop from its menu." },
  { title: "Always current", body: "Focus the window and it re-checks branches and the worktree. A background fetch keeps ahead/behind honest." },
  { title: "Tabs that remember", body: "Selected commit, file and panel state per repository. Drag to reorder; idle tabs sleep to save memory." },
  { title: "Right-click everything", body: "Check out a branch or commit, copy hashes and ref names, merge, undo the tip, handle stashes." },
  { title: "Light and dark glass", body: "Two themes, zoom the whole window with Ctrl plus, minus and zero, window position restored on launch." },
  { title: "Updates itself", body: "Checks on launch, downloads in the background, restarts when you say so." },
];
---

<Site title={title} description={description}>
  <header class="sticky top-0 z-50 border-b border-rule backdrop-blur-xl" style="background-color: var(--color-glass-soft)">
    <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6">
      <a href="/" class="flex items-center gap-2.5" aria-label="Git Mapper home">
        <span class="inline-block h-8 w-8" set:html={logoRaw} aria-hidden="true" />
        <span class="text-[15px] font-bold tracking-tight">Git Mapper</span>
      </a>
      <nav class="flex items-center gap-1 text-sm font-semibold" aria-label="Main">
        <a href="#features" class="hidden rounded-lg px-3 py-1.5 text-ink-soft hover:bg-hover-glass hover:text-ink sm:block">Features</a>
        <a href="#install" class="hidden rounded-lg px-3 py-1.5 text-ink-soft hover:bg-hover-glass hover:text-ink sm:block">Install</a>
        <a
          href={REPO}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-2 flex items-center gap-2 rounded-lg border border-hairline px-3 py-1.5 text-ink backdrop-blur-md transition-colors hover:bg-hover-glass"
          style="background-color: var(--color-glass-strong)"
        >
          <span class="inline-block h-4 w-4" set:html={iconGithub} />
          GitHub
        </a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-6">
    <!-- Hero -->
    <section class="site-rise mx-auto max-w-3xl pb-12 pt-20 text-center md:pt-28">
      <h1 class="text-balance text-[clamp(2.6rem,5.4vw,4.25rem)] font-bold leading-[1.06] tracking-[-0.03em]">
        Every branch, crystal clear.
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
        Git Mapper is a fast, lightweight Git history viewer. Open a repository
        and follow the graph, diffs and stashes on a clean pane — no account,
        no setup.
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href={RELEASES}
          class="flex items-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-white soft-shadow transition-[filter] hover:brightness-110"
        >
          <span class="inline-block h-4 w-4" set:html={iconDownload} />
          Download free
        </a>
        <a
          href={REPO}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg border border-hairline px-5 py-2.5 text-sm font-semibold text-ink backdrop-blur-md transition-colors hover:bg-hover-glass"
          style="background-color: var(--color-glass-strong)"
        >
          Browse source
        </a>
      </div>
      <p class="mt-5 font-mono text-xs tracking-tight text-ink-dim">
        Windows · macOS · Linux · free
      </p>
    </section>

    <!-- Theme comparison dragger -->
    <section class="site-rise mx-auto max-w-5xl pb-10">
      <div class="panel-shadow rounded-3xl border border-hairline p-2.5 backdrop-blur-xl md:p-3.5" style="background-color: var(--color-glass / 0.55)">
        <ThemeSlider
          client:visible
          lightSrc="/screens/main-light.png"
          darkSrc="/screens/main-dark.png"
          altLight="Git Mapper with a repository open, light theme: glass commit feed, lane-coloured graph, diff panel"
          altDark="The same repository in the dark theme: deep canvas with white halos, smoked glass panes"
        />
        <p class="mt-2.5 px-1.5 font-mono text-xs text-ink-dim">
          Same repository, both themes — drag the divider, or press arrow keys while it is focused.
        </p>
      </div>
    </section>

    <!-- Stats strip -->
    <section class="mx-auto mt-16 grid max-w-4xl grid-cols-2 gap-3 md:grid-cols-4">
      {stats.map((s) => (
        <div class="glass-panel panel-shadow rounded-2xl px-4 py-4 text-center">
          <p class="text-[1.6rem] font-bold tracking-tight text-primary-ink">{s.value}</p>
          <p class="mt-0.5 text-xs text-ink-dim">{s.label}</p>
        </div>
      ))}
    </section>

    <!-- Features -->
    <section id="features" class="mt-24 scroll-mt-24 md:mt-32">
      <div class="mx-auto max-w-2xl text-center">
        <p class="font-mono text-xs font-bold uppercase tracking-widest text-primary-ink">Features</p>
        <h2 class="mt-3 text-balance text-[clamp(1.7rem,3vw,2.4rem)] font-bold leading-snug tracking-[-0.02em]">
          Read the history. Then do something about it.
        </h2>
        <p class="mt-4 text-ink-soft">
          Git Mapper began as a viewer and grew a careful set of verbs: stage,
          commit, sync and merge, all without leaving the graph.
        </p>
      </div>

      <!-- Row 1: the graph -->
      <div class="mt-14 grid items-center gap-8 md:grid-cols-2 md:gap-12">
        <div>
          <p class="font-mono text-xs font-bold uppercase tracking-widest text-ink-dim">Read history</p>
          <h3 class="mt-2 text-[1.5rem] font-bold tracking-tight">The graph, in lane colours</h3>
          <p class="mt-3 text-ink-soft">
            Every branch owns a hue from tip to root. Forks bend exactly at their
            commit, merges join back cleanly, and dense lanes stay readable
            hundreds of rows in.
          </p>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-[0.95rem] text-ink-soft">
            <li>Branch, remote and tag pills on every row; double-click to check out</li>
            <li>Search by hash, message, author or ref, with Ctrl+F</li>
            <li>Reorder, resize and hide columns to suit you</li>
            <li>Each repository in its own tab, restored on launch</li>
          </ul>
        </div>
        <div class="panel-shadow min-w-0 rounded-3xl border border-hairline p-2 backdrop-blur-xl md:p-2.5" style="background-color: var(--color-glass-soft)">
          <img src="/screens/graph.png" alt="The commit graph: five branches in their own colours forking and merging back into main, with branch, tag and stash pills on the rows" width="1400" height="894" loading="lazy" decoding="async" class="block h-auto w-full rounded-2xl border border-rule" />
        </div>
      </div>

      <!-- Change things -->
      <div class="mt-24">
        <div class="mx-auto max-w-2xl text-center">
          <p class="font-mono text-xs font-bold uppercase tracking-widest text-ink-dim">Change things</p>
          <h3 class="mt-2 text-[1.5rem] font-bold tracking-tight">Stage, commit, undo</h3>
          <p class="mt-3 text-ink-soft">The uncommitted row opens a staging rail beside the diff. Stage, unstage or discard by file, write the message and commit. Changed your mind? Undo the tip commit and its files come back staged.</p>
        </div>
        <div class="panel-shadow mx-auto mt-8 max-w-5xl rounded-3xl border border-hairline p-2.5 backdrop-blur-xl md:p-3.5" style="background-color: var(--color-glass-soft)">
          <img src="/screens/stage.png" alt="The staging rail listing a staged file and three changes beside the staged diff of src/lib/graph.ts, with an Unstage hunk button" width="2200" height="1520" loading="lazy" decoding="async" class="block h-auto w-full rounded-2xl border border-rule" />
        </div>
        <ul class="mx-auto mt-6 grid max-w-5xl gap-x-6 gap-y-3 sm:grid-cols-2 lg:grid-cols-4">
            <li class="flex items-start gap-2.5 text-[0.9rem] leading-snug text-ink-soft"><span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-primary/12 text-[10px] font-bold text-primary-ink" aria-hidden="true">✓</span><span>Stage, unstage or discard a whole hunk in one click</span></li>
            <li class="flex items-start gap-2.5 text-[0.9rem] leading-snug text-ink-soft"><span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-primary/12 text-[10px] font-bold text-primary-ink" aria-hidden="true">✓</span><span>Fetch, pull (fast-forward only) and push from the branch counters</span></li>
            <li class="flex items-start gap-2.5 text-[0.9rem] leading-snug text-ink-soft"><span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-primary/12 text-[10px] font-bold text-primary-ink" aria-hidden="true">✓</span><span>Destructive actions sit behind a clear confirm</span></li>
            <li class="flex items-start gap-2.5 text-[0.9rem] leading-snug text-ink-soft"><span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-primary/12 text-[10px] font-bold text-primary-ink" aria-hidden="true">✓</span><span>The rail docks itself once the working tree is clean</span></li>
        </ul>
      </div>

      <!-- Row 3: hunks and lines -->
      <div class="mt-24">
        <div class="mx-auto max-w-2xl text-center">
          <p class="font-mono text-xs font-bold uppercase tracking-widest text-ink-dim">Change things</p>
          <h3 class="mt-2 text-[1.5rem] font-bold tracking-tight">Down to the single line</h3>
          <p class="mt-3 text-ink-soft">
            Stage or discard one hunk, or tick just the lines you mean. Commit
            half of a messy file as two clean commits, no command line needed.
          </p>
        </div>
        <div class="panel-shadow mx-auto mt-8 max-w-5xl rounded-3xl border border-hairline p-2.5 backdrop-blur-xl md:p-3.5" style="background-color: var(--color-glass-soft)">
          <img src="/screens/hunk.png" alt="An uncommitted diff with five changed lines ticked, and the hunk header now offering Stage +4 -1, Discard +4 -1 and Clear" width="2260" height="700" loading="lazy" decoding="async" class="block h-auto w-full rounded-2xl border border-rule" />
        </div>
        <ul class="mx-auto mt-6 grid max-w-5xl gap-x-6 gap-y-3 sm:grid-cols-2 lg:grid-cols-4">
          <li class="flex items-start gap-2.5 text-[0.9rem] leading-snug text-ink-soft"><span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-primary/12 text-[10px] font-bold text-primary-ink" aria-hidden="true">✓</span><span>Tick the gutter, or drag across several lines</span></li>
          <li class="flex items-start gap-2.5 text-[0.9rem] leading-snug text-ink-soft"><span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-primary/12 text-[10px] font-bold text-primary-ink" aria-hidden="true">✓</span><span>The hunk's buttons become Stage, Unstage or Discard N lines</span></li>
          <li class="flex items-start gap-2.5 text-[0.9rem] leading-snug text-ink-soft"><span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-primary/12 text-[10px] font-bold text-primary-ink" aria-hidden="true">✓</span><span>Staged and unstaged sides shown one at a time, like VS Code</span></li>
          <li class="flex items-start gap-2.5 text-[0.9rem] leading-snug text-ink-soft"><span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-primary/12 text-[10px] font-bold text-primary-ink" aria-hidden="true">✓</span><span>A hunk that moved underneath you is refused, never misapplied</span></li>
        </ul>
      </div>

      <!-- Change things -->
      <div class="mt-24">
        <div class="mx-auto max-w-2xl text-center">
          <p class="font-mono text-xs font-bold uppercase tracking-widest text-ink-dim">Change things</p>
          <h3 class="mt-2 text-[1.5rem] font-bold tracking-tight">Merge, and settle conflicts in place</h3>
          <p class="mt-3 text-ink-soft">Merge a local branch from its pill. If git stops on conflicts they land in the rail: take a side per file, or open the file and pick current, incoming or both for each block.</p>
        </div>
        <div class="panel-shadow mx-auto mt-8 max-w-5xl rounded-3xl border border-hairline p-2.5 backdrop-blur-xl md:p-3.5" style="background-color: var(--color-glass-soft)">
          <img src="/screens/conflict.png" alt="A merge conflict in src/config.ts shown inline with Keep current, Keep both and Keep incoming buttons, and a Conflicts section in the staging rail" width="2200" height="1800" loading="lazy" decoding="async" class="block h-auto w-full rounded-2xl border border-rule" />
        </div>
        <ul class="mx-auto mt-6 grid max-w-5xl gap-x-6 gap-y-3 sm:grid-cols-2 lg:grid-cols-4">
            <li class="flex items-start gap-2.5 text-[0.9rem] leading-snug text-ink-soft"><span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-primary/12 text-[10px] font-bold text-primary-ink" aria-hidden="true">✓</span><span>Conflict blocks inline, with line numbers and syntax colours</span></li>
            <li class="flex items-start gap-2.5 text-[0.9rem] leading-snug text-ink-soft"><span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-primary/12 text-[10px] font-bold text-primary-ink" aria-hidden="true">✓</span><span>Keep current, keep incoming, or keep both, block by block</span></li>
            <li class="flex items-start gap-2.5 text-[0.9rem] leading-snug text-ink-soft"><span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-primary/12 text-[10px] font-bold text-primary-ink" aria-hidden="true">✓</span><span>Finish with git's own prepared message</span></li>
            <li class="flex items-start gap-2.5 text-[0.9rem] leading-snug text-ink-soft"><span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-primary/12 text-[10px] font-bold text-primary-ink" aria-hidden="true">✓</span><span>Or abort and the repository returns to how it was</span></li>
        </ul>
      </div>

      <!-- Read changes -->
      <div class="mt-24">
        <div class="mx-auto max-w-2xl text-center">
          <p class="font-mono text-xs font-bold uppercase tracking-widest text-ink-dim">Read changes</p>
          <h3 class="mt-2 text-[1.5rem] font-bold tracking-tight">Diffs that read</h3>
          <p class="mt-3 text-ink-soft">Unified or split like GitHub, syntax highlighted in three colour schemes, with word-level marks showing exactly what changed.</p>
        </div>
        <div class="panel-shadow mx-auto mt-8 max-w-5xl rounded-3xl border border-hairline p-2.5 backdrop-blur-xl md:p-3.5" style="background-color: var(--color-glass-soft)">
          <img src="/screens/split.png" alt="A commit selected in the graph with its split diff open: the old lines on the left, the new lines on the right" width="2560" height="1520" loading="lazy" decoding="async" class="block h-auto w-full rounded-2xl border border-rule" />
        </div>
        <ul class="mx-auto mt-6 grid max-w-5xl gap-x-6 gap-y-3 sm:grid-cols-2 lg:grid-cols-4">
            <li class="flex items-start gap-2.5 text-[0.9rem] leading-snug text-ink-soft"><span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-primary/12 text-[10px] font-bold text-primary-ink" aria-hidden="true">✓</span><span>One file at a time, or every changed file stacked in one scroll</span></li>
            <li class="flex items-start gap-2.5 text-[0.9rem] leading-snug text-ink-soft"><span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-primary/12 text-[10px] font-bold text-primary-ink" aria-hidden="true">✓</span><span>Flat list or folder tree, with status badges and renames</span></li>
            <li class="flex items-start gap-2.5 text-[0.9rem] leading-snug text-ink-soft"><span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-primary/12 text-[10px] font-bold text-primary-ink" aria-hidden="true">✓</span><span>Picture diffs for images: 2-up, swipe or onion peel</span></li>
            <li class="flex items-start gap-2.5 text-[0.9rem] leading-snug text-ink-soft"><span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-primary/12 text-[10px] font-bold text-primary-ink" aria-hidden="true">✓</span><span>Hover a file and its patch is already loading</span></li>
        </ul>
      </div>

      <!-- Everything else -->
      <div class="mx-auto mt-24 max-w-2xl text-center">
        <h3 class="text-balance text-[clamp(1.4rem,2.4vw,1.9rem)] font-bold tracking-[-0.02em]">And the details that add up</h3>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {extras.map((e) => (
          <article class="glass-panel panel-shadow rounded-2xl p-5">
            <h4 class="text-[1.02rem] font-bold tracking-tight">{e.title}</h4>
            <p class="mt-1.5 text-[0.92rem] text-ink-soft">{e.body}</p>
          </article>
        ))}
      </div>

      <!-- Control -->
      <div class="glass-panel panel-shadow mx-auto mt-14 flex max-w-3xl items-start gap-4 rounded-2xl p-5 md:p-6">
        <span class="mt-0.5 inline-block h-5 w-5 shrink-0 text-primary-ink" set:html={iconLock} />
        <div>
          <h3 class="text-[1.05rem] font-bold tracking-tight">You stay in control</h3>
          <p class="mt-1.5 text-[0.95rem] text-ink-soft">
            Git Mapper runs your own <code class="font-mono text-[0.85em]">git</code> and
            only does what you click. Pulls are fast-forward only, and anything that
            throws work away, such as discard, drop or detach, asks first.
            No account, no cloud.
          </p>
        </div>
      </div>
    </section>

    <!-- Install -->
    <section id="install" class="mt-24 scroll-mt-24 pb-24 md:mt-32">
      <div class="mx-auto max-w-2xl">
        <h2 class="text-balance text-[clamp(1.7rem,3vw,2.4rem)] font-bold leading-snug tracking-[-0.02em]">
          Try it on your own repos
        </h2>
        <p class="mt-4 text-ink-soft">
          The installer for your system lives on GitHub Releases. The app checks
          for updates on launch and stays current on its own.
        </p>
      </div>

      <div class="glass-panel panel-shadow mt-10 overflow-hidden rounded-2xl">
        <div class="flex items-center gap-4 border-b border-rule px-5 py-4 max-sm:flex-col max-sm:items-stretch max-sm:gap-3">
          <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg glass-panel text-ink">
            <span class="inline-block h-4 w-4" set:html={iconWindows} />
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-bold">Windows</p>
            <p class="truncate font-mono text-[11px] text-ink-dim">Git.Mapper_x64-setup.exe</p>
          </div>
          <a href={DOWNLOADS.windows} class="shrink-0 rounded-lg bg-primary px-4 py-2 text-center text-xs font-semibold text-white soft-shadow transition-[filter] hover:brightness-110">Download</a>
        </div>

        <div class="flex items-center gap-4 border-b border-rule px-5 py-4 max-sm:flex-col max-sm:items-stretch max-sm:gap-3">
          <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg glass-panel text-ink">
            <span class="inline-block h-4 w-4" set:html={iconApple} />
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-bold">macOS</p>
            <p class="font-mono text-[11px] text-ink-dim">Git.Mapper.dmg — Apple Silicon &#43; Intel · first launch: right-click &#42; Open (signed, not notarized)</p>
          </div>
          <a href={DOWNLOADS.macos} class="shrink-0 rounded-lg bg-primary px-4 py-2 text-center text-xs font-semibold text-white soft-shadow transition-[filter] hover:brightness-110">Download</a>
        </div>

        <div class="flex items-center gap-4 px-5 py-4 max-sm:flex-col max-sm:items-stretch max-sm:gap-3">
          <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg glass-panel text-ink">
            <span class="inline-block h-4 w-4" set:html={iconPackage} />
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-bold">Linux</p>
            <p class="font-mono text-[11px] text-ink-dim">Git.Mapper_amd64.AppImage — runs without installing</p>
          </div>
          <a href={DOWNLOADS.linux} class="shrink-0 rounded-lg bg-primary px-4 py-2 text-center text-xs font-semibold text-white soft-shadow transition-[filter] hover:brightness-110">Download</a>
        </div>
      </div>

      <p class="mt-6 text-center text-sm text-ink-soft">
        Or browse <a class="font-semibold text-primary-ink underline underline-offset-2 hover:underline" href={REPO}>the source on GitHub</a> and build it yourself with Tauri 2.
      </p>
    </section>
  </main>

  <footer class="border-t border-rule">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-8 text-sm text-ink-dim">
      <div class="flex items-center gap-2.5">
        <span class="inline-block h-6 w-6" set:html={logoRaw} aria-hidden="true" />
        <span class="font-semibold text-ink-soft">Git Mapper</span>
        <span>— a lightweight Git history viewer</span>
      </div>
      <nav class="flex items-center gap-5" aria-label="Footer">
        <a class="hover:text-ink" href={REPO}>GitHub</a>
        <a class="hover:text-ink" href={`${REPO}/releases`}>Releases</a>
        <a class="hover:text-ink" href="https://fajarwz.com">fajarwz.com</a>
      </nav>
    </div>
  </footer>
</Site>
