{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Mapper",
  "version": "1.1.1",
  "identifier": "com.fajar.git-mapper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Git Mapper",
        "width": 1320,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "theme": "Light",
        "backgroundColor": "#ffffff",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDM0NGNzE3OUI5MTEwMDcKUldRSEVKR2JGL2M4M0s4dzhxejI3aUVtU2c4bk8rZVp6d2JjeVI0OEtVWDlmN2VmWGUrc0Nlc0kK",
      "endpoints": [
        "https://github.com/fajarwz/git-mapper/releases/latest/download/latest.json"
      ]
    }
  }
}
